# Copy to .env. All config is via environment variables (INF2).
# Values that differ per instance (INSTANCE_ID, ports) are set in docker-compose.yml.

LOG_LEVEL=info

# --- Auth ---
# >= 32 bytes. Generate: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_TTL=24h
# DEV ONLY: POST /v1/auth/dev-login issues a token for any username.
AUTH_DEV_LOGIN_ENABLED=true

# --- PostgreSQL ---
POSTGRES_MAX_CONNS=20

# --- Kafka ---
KAFKA_TOPIC_MESSAGES=chat.messages
KAFKA_TOPIC_RECEIPTS=chat.receipts
KAFKA_TOPIC_RETRY=chat.retry
KAFKA_TOPIC_DLQ=chat.dlq
# New consumer groups start at latest; history comes from PostgreSQL sync.
KAFKA_START_FROM_LATEST=true

# kafka | redis   (redis = Pub/Sub fallback / EXP13 comparison)
DELIVERY_TRANSPORT=kafka

# --- Outbox relay ---
RELAY_ENABLED=true
RELAY_POLL_INTERVAL=100ms
RELAY_BATCH_SIZE=200
RELAY_ADVISORY_LOCK_ID=727001
OUTBOX_RETENTION=24h

# --- WebSocket ---
WS_ALLOWED_ORIGINS=localhost:*
WS_PING_INTERVAL=20s
WS_PONG_TIMEOUT=10s
WS_SEND_BUFFER=256
WS_MAX_CONNS_PER_USER=5
WS_MAX_MESSAGE_BYTES=65536

# --- Limits / presence ---
RATE_LIMIT_PER_SECOND=20
PRESENCE_TTL=60s
# Static membership (group.instance.id = INSTANCE_ID) for fast restarts (KF10)
KAFKA_STATIC_MEMBERSHIP=true
